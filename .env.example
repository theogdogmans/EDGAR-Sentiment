# SEC EDGAR (required) — identify yourself per SEC fair-access policy
SEC_USER_AGENT=edgar-sentiment/0.1 (Your Name your-email@example.com)

# Phase 3 local DB filename under backend/data/ (default is fine for transfer resume)
PHASE3_DB_NAME=edgar_phase3.db

# Optional: only needed if you publish aggregates to Supabase (do NOT publish during Phase 3 rebuild)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional frontend publishable values live in frontend/.env.example — never put service-role keys there.

# FinBERT / rebuild knobs (safe defaults)
# FINBERT_MODEL=ProsusAI/finbert
# MAX_FILINGS=20
# HTTP_TIMEOUT_S=60
# HTTP_DOWNLOAD_TIMEOUT_S=90
# HTTP_MAX_RETRIES=2
# FILING_SOFT_TIMEOUT_S=600
# FILING_MAX_ATTEMPTS=2
# REQUEST_PAUSE_S=0.12
# MIN_CIK_HISTORY=6
