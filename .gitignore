.venv/
__pycache__/
*.py[cod]
.env
.env.local
frontend/.env.local
frontend/.env.production
node_modules/
.next/
tsconfig.tsbuildinfo
out/
.DS_Store
Thumbs.db
*.log
huggingface/
.cache/
.tools/
tmp_sync*
tmp_co_*
_build_sync_sql.py
_print_aapl.py

# SQLite sidecars never committed
*.db-wal
*.db-shm

# Ignore local DBs by default
*.db

# Ignore working data dir contents…
backend/data/*
!backend/data/.gitkeep

# …except the Mac→Windows transfer package (DB via Git LFS)
!backend/data/transfer/
!backend/data/transfer/
!backend/data/transfer/**
!backend/data/transfer/*.db

# Re-ignore SQLite sidecars under transfer/
backend/data/transfer/*.db-wal
backend/data/transfer/*.db-shm

# Phase 4 research report artifacts (not the multi-GB final DB)
!backend/data/phase4/
!backend/data/phase4/**
backend/data/phase4/*.db
backend/data/phase4/*.db-wal
backend/data/phase4/*.db-shm
backend/data/final/*.db
backend/data/final/*.db-wal
backend/data/final/*.db-shm
